--target-os=none
--arch=x86_32
--enable-cross-compile
--disable-asm
--disable-stripping
--disable-programs
--disable-doc
--disable-debug
--disable-runtime-cpudetect
--disable-autodetect
--disable-everything
--disable-network
--disable-pthreads
--disable-w32threads
--disable-os2threads
--disable-postproc
--nm=emnm
--ar=emar
--ranlib=emranlib
--cc=emcc
--cxx=em++
--objcc=emcc
--dep-cc=emcc
--extra-cflags=-O3
--extra-cxxflags=-O3
--enable-demuxer=mov,matroska,mpegts,hls,aac,mp3,flac,ogg,wav,ac3,eac3
--enable-muxer=mp4,ipod,matroska
--enable-protocol=file
--enable-decoder=aac,aac_latm,mp3,mp3float,mp2,mp2float,vorbis,opus,flac,ac3,eac3,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,pcm_s16be,pcm_s24be,pcm_s32be,pcm_f32be,pcm_f64le,pcm_f64be,pcm_u8,pcm_s8,pcm_alaw,pcm_mulaw
--enable-encoder=aac
--enable-parser=aac,aac_latm,ac3,flac,h264,hevc,mpegaudio,mpegvideo,opus,vorbis,vp8,vp9,av1
--enable-bsf=aac_adtstoasc,extract_extradata,h264_mp4toannexb,hevc_mp4toannexb,vp9_superframe
--enable-filter=abuffer,abuffersink,aformat,anull,aresample,atrim,buffer,buffersink,null,format,trim
