{
  "manifest_version": 3,
  "name": "Video Grabber",
  "version": "1.0.0",
  "description": "재생 페이지의 미디어 트래픽을 감지하고 영상과 오디오를 저장합니다.",
  "minimum_chrome_version": "125",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webRequest",
    "downloads",
    "unlimitedStorage",
    "debugger"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "이 페이지의 동영상 수집"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none';"
  },
  "key": ""
}
